# ---- Solana ----
NEXT_PUBLIC_SOLANA_CLUSTER=devnet            # devnet while testing, mainnet-beta for launch
NEXT_PUBLIC_RPC_URL=                         # optional public RPC for the browser
SOLANA_RPC_URL=                              # server RPC (e.g. a Helius URL). Kept secret.

# ---- People ----
NEXT_PUBLIC_REFEREE_WALLET=                  # your Phantom address: the 3rd vote on every vault
NEXT_PUBLIC_FEE_BPS=0                        # platform fee in basis points (300 = 3%), max 1000
NEXT_PUBLIC_FEE_WALLET=                      # where fees go (required if fee > 0)

# ---- Database (Supabase → Project settings → API) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sessions ----
SESSION_SECRET=                              # any random string, 32+ characters

NEXT_PUBLIC_SITE_NAME=Gigs
